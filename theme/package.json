{
  "name": "slidev-theme-shotgun-slides",
  "version": "0.2.0",
  "description": "Slidev theme matching Shotgun's \"[Template] Slides\" Figma deck",
  "author": "Shotgun",
  "license": "UNLICENSED",
  "keywords": [
    "slidev-theme",
    "slidev",
    "shotgun"
  ],
  "engines": {
    "node": ">=20.12.0",
    "slidev": ">=52.0.0"
  },
  "slidev": {
    "colorSchema": "dark",
    "defaults": {
      "colorSchema": "dark",
      "transition": "slide-left",
      "fonts": {
        "sans": "Space Grotesk",
        "mono": "JetBrains Mono",
        "weights": "400,500,700",
        "local": "Monument Extended"
      },
      "themeConfig": {
        "primary": "#46ecd5"
      }
    }
  },
  "dependencies": {
    "@slidev/types": "^52.19.1"
  }
}
